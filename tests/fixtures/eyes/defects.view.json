{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 400,
      "width": 600
    }
  },
  "root": {
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex",
    "children": [
      {
        "events": {
          "system": {
            "onStartup": {
              "config": {
                "script": "\traise RuntimeError('PDK seeded startup defect')"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Healthy"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "'OK ' + (1 + 1)"
              },
              "type": "expr"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "MissingTag"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "fallbackDelay": 2.5,
                "mode": "direct",
                "tagPath": "[default]PDK_Eyes/NoSuchTag"
              },
              "type": "tag"
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "ScriptError"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "'input'"
              },
              "type": "expr",
              "transforms": [
                {
                  "code": "\traise ValueError('PDK seeded script defect')",
                  "type": "script"
                }
              ]
            }
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "Row"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "props": {
          "direction": "row"
        },
        "type": "ia.container.flex",
        "children": [
          {
            "meta": {
              "name": "Narrow"
            },
            "position": {
              "basis": "120px",
              "shrink": 0
            },
            "props": {
              "style": {
                "overflow": "hidden",
                "textOverflow": "ellipsis",
                "whiteSpace": "nowrap"
              },
              "text": "This label text is far too long to fit in one hundred and twenty pixels"
            },
            "type": "ia.display.label"
          }
        ]
      },
      {
        "meta": {
          "name": "Collapsed"
        },
        "position": {
          "basis": "0px",
          "grow": 0,
          "shrink": 1
        },
        "props": {
          "direction": "column"
        },
        "type": "ia.container.flex",
        "children": [
          {
            "meta": {
              "name": "Hidden"
            },
            "position": {
              "basis": "32px"
            },
            "props": {
              "text": "Content nobody can see"
            },
            "type": "ia.display.label"
          }
        ]
      }
    ]
  }
}
