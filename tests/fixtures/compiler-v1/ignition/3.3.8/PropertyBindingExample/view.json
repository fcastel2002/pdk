{
  "custom": {},
  "params": {
    "titulo": "Estado del tanque",
    "valor": 42
  },
  "props": {},
  "root": {
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex",
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "32px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.titulo"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "hmi-typography-body"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "EmbeddedView"
        },
        "position": {
          "basis": "300px"
        },
        "propConfig": {
          "props.params.valor": {
            "binding": {
              "config": {
                "path": "view.params.valor"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "path": "Page/SensorCard",
          "params": {
            "mode": "auto"
          }
        },
        "type": "ia.display.view"
      }
    ]
  }
}