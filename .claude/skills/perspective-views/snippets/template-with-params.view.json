{
  "custom": {},
  "params": {
    "flow": 0,
    "name": "",
    "running": false
  },
  "propConfig": {
    "params.flow": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.name": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.running": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 48,
      "width": 480
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Label"
        },
        "position": {
          "basis": "160px"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "path": "view.params.name"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "classes": "hmi-typography-body"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "NumericEntry"
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "config": {
                "path": "view.params.flow"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "enabled": false
        },
        "type": "ia.input.numeric-entry-field"
      },
      {
        "meta": {
          "name": "Checkbox"
        },
        "propConfig": {
          "props.selected": {
            "binding": {
              "config": {
                "path": "view.params.running"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "enabled": false,
          "text": "Running"
        },
        "type": "ia.input.checkbox"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "style": {
        "classes": "hmi-spacing-sm"
      }
    },
    "type": "ia.container.flex"
  }
}